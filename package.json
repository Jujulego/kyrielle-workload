{
  "name": "@kyrielle/workload",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Julien Capellari <julien.capellari@gmail.com>",
  "repository": "github:Jujulego/kyrielle-workload",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "clean": "shx rm -r dist",
    "build": "yarn run build:esm && yarn run build:types",
    "build:esm": "swc src -d dist --strip-leading-paths",
    "build:types": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:types": "tsc --project tests"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.0",
    "kyrielle": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jujulego/jill": "3.0.7",
    "@jujulego/vite-plugin-swc": "1.2.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@swc/cli": "0.8.0",
    "@swc/core": "1.15.18",
    "@types/node": "24.12.0",
    "@vitest/coverage-v8": "4.1.0",
    "@vitest/eslint-plugin": "1.6.12",
    "eslint": "10.0.3",
    "jiti": "2.6.1",
    "shx": "0.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.0"
  },
  "packageManager": "yarn@4.12.0"
}
